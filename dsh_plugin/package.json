{
  "name": "dsh-dream",
  "version": "0.3.6",
  "displayName": "DSH-DREAM 长期记忆",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "description": "DSH-native settings panel for the DSH-DREAM Python package.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "holographic_events.js",
    "runtime_env.js",
    "bridge_process.js",
    "memory_tools.js",
    "pre_retrieval.js",
    "turn_bridge.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/*.png",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5-rc.1 <4.0.0-0"
  },
  "icon": "icon.png"
}
